# Required before the bot can connect. Keep real credentials out of source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_TARGET_CHAT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=

# Durable local state. SQLite timestamps are ISO-8601 UTC strings.
DATABASE_URL=sqlite:///./data/bot.sqlite3
LOG_LEVEL=INFO
TIMEZONE=Africa/Addis_Ababa

# Safe limits. Daily Gemini budget counts requests conservatively, reserving one
# request before each call. Quota uncertainty pauses generation until next reset.
GEMINI_DAILY_REQUEST_BUDGET=10
GEMINI_DAILY_TOKEN_BUDGET=0
GEMINI_RESET_TIMEZONE=UTC
ARTICLE_TEXT_RETENTION_DAYS=7

# Scheduler and publishing controls.
RSS_POLL_INTERVAL_MINUTES=30
PROCESS_INTERVAL_MINUTES=5
PUBLICATION_DAILY_LIMIT=5
PUBLICATION_WINDOW_START=08:00
PUBLICATION_WINDOW_END=21:00
MAX_OVERDUE_AGE_HOURS=24
CATCHUP_MIN_INTERVAL_MINUTES=180
PUBLISH_RETRY_LIMIT=3
RETRY_BASE_SECONDS=60

# Conservative fetch limits.
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_MAX_RESPONSE_BYTES=2000000
HTTP_MAX_REDIRECTS=3
HTTP_ALLOWED_PORTS=80,443

# Comma-separated configured RSS feed URLs (all are still subjected to SSRF checks).
RSS_FEED_URLS=

